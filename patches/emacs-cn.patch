+  if (STRINGP (str) && HASH_TABLE_P (Vchinese_l10n_table))
+    {
+      Lisp_Object res = Fgethash (str, Vchinese_l10n_table, Qnil);
+      if (STRINGP (res))
+	return res;
+    }
+  return str;
+}
