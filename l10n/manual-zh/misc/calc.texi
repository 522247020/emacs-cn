@smallexample
@group
1:  2@@ 30' 0"     1:  3@@ 30' 0"     2:  3@@ 30' 0"     1:  2.
    .                 .             1:  1@@ 45' 0."        .
                                        .

  2@@ 30' @key{RET}          1 +               @key{RET} 2 /           /
@end group
