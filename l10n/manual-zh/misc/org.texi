@item @kbd{S-@key{UP}}@comma{} @kbd{S-@key{DOWN}}@comma{} @kbd{S-@key{LEFT}}@comma{} @kbd{S-@key{RIGHT}}
@kindex S-UP
@kindex S-DOWN
@kindex S-LEFT
@kindex S-RIGHT
